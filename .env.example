# AI Provider Selection
# Options: agnes, glm, nvidia
# Default: agnes
AI_PROVIDER=agnes

# Agnes AI API Configuration
# Get your API key from https://apihub.agnes-ai.com/
AGNES_API_KEY=your_agnes_api_key_here

# GLM API Configuration (Zhipu AI)
# Get your API key from https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here

# DeepSeek API Configuration (Optional)
# Get your API key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# NVIDIA API Configuration (Optional)
# Get your API key from https://build.nvidia.com/deepseek-ai/deepseek-v3-1
NVIDIA_API_KEY=your_nvidia_api_key_here
